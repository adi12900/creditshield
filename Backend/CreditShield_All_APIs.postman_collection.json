    {
      "name": "Setu Account Aggregator",
      "item": [
        {
          "name": "POST /api/v1/setu/setu/token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force_refresh\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/setu/setu/token"
          }
        },
        {
          "name": "POST /api/v1/setu/setu/consents",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vua\": \"9999999999@onemoney\",\n  \"dataRange\": {\n    \"from\": \"2023-01-01T00:00:00Z\",\n    \"to\": \"2023-12-31T23:59:59Z\"\n  },\n  \"fiTypes\": [\"DEPOSIT\"],\n  \"consentTypes\": [\"PROFILE\", \"SUMMARY\", \"TRANSACTIONS\"],\n  \"consentDuration\": {\n    \"unit\": \"MONTH\",\n    \"value\": 6\n  },\n  \"purpose\": {\n    \"code\": \"103\",\n    \"text\": \"Loan underwriting and risk assessment\",\n    \"refUri\": \"https://www.setu.co/purpose\",\n    \"category\": {\n      \"type\": \"LOAN\"\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/setu/setu/consents"
          }
        },
        {
          "name": "POST /api/v1/setu/setu/consents/{consent_id}/data-fetch",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consentId\": \"{{consentId}}\",\n  \"dataRange\": {\n    \"from\": \"2023-01-01T00:00:00Z\",\n    \"to\": \"2023-12-31T23:59:59Z\"\n  },\n  \"format\": \"json\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/setu/setu/consents/{{consentId}}/data-fetch"
          }
        },
        {
          "name": "GET /api/v1/setu/setu/sessions/{session_id}",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/setu/setu/sessions/{{sessionId}}"
          }
        },
        {
          "name": "POST /api/v1/setu/setu/webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"event_123\",\n  \"consentId\": \"{{consentId}}\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/setu/setu/webhook"
          }
        },
        {
          "name": "POST /api/v1/setu/setu/fetch-transactions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consent_id\": \"{{consentId}}\",\n  \"from_date\": \"2023-01-01\",\n  \"to_date\": \"2023-12-31\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/setu/setu/fetch-transactions"
          }
        }
      ]
